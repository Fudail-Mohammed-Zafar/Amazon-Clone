# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Signs/verifies the admin JWT — use a long, random string, even for local dev
JWT_SECRET=

# Credentials for the /admin login screen (there is no user table — a single hardcoded admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MongoDB connection string. Do NOT include a database name at the end —
# the app appends "/stockhub" itself (see server/configs/mongoDb.js)
MONGODB_URI=

# From your ImageKit dashboard (imagekit.io) — used for blog image upload + delivery
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# From Google AI Studio (aistudio.google.com) — powers "Generate with AI" in the blog editor
GEMINI_API_KEY=
